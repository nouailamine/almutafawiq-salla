<section
    component-id="{{ componentId }}"
    class="mtf-hero"
    dir="rtl"
>
    <div class="container">
        <div class="mtf-hero__content">

            <span class="mtf-hero__eyebrow">
                خدمات المتفوق المهنية
            </span>

            <h1 class="mtf-hero__title">
                طوّر حضورك المهني
                <br>
                وحقق أهدافك بثقة
            </h1>

            <p class="mtf-hero__description">
                حلول مهنية احترافية للأفراد والشركات،
                مصممة لتساعدك على الظهور بصورة أقوى
                والوصول إلى أهدافك بشكل أكثر احترافية.
            </p>

            <div class="mtf-hero__actions">

                <a
                    href="#mtf-services"
                    class="mtf-btn mtf-btn--primary"
                >
                    اكتشف خدماتنا
                </a>

                <a
                    href="#mtf-contact"
                    class="mtf-btn mtf-btn--secondary"
                >
                    تواصل معنا
                </a>

            </div>

        </div>
    </div>
</section>
